---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/common/PageHeader.astro";
import TopBtn from "@/components/common/TopBtn.astro";
import { Image } from 'astro:assets';
import technicalImg01 from '@/assets/images/projects/pro_09_03.jpg';
import technicalImg02 from '@/assets/images/projects/pro_09_04.jpg';
import technicalImg03 from '@/assets/images/projects/pro_09_05.jpg';
import technicalImg04 from '@/assets/images/projects/pro_09_01.jpg';
import pickupImg01 from '@/assets/images/feat_picup_01.jpg';
import pickupImg02 from '@/assets/images/feat_picup_02.jpg';
import proposalImg from '@/assets/images/feat_proposal_01.jpg';
import warehouseImg01 from '@/assets/images/feat_warehouse_01.jpg';
import warehouseImg02 from '@/assets/images/feat_warehouse_02.jpg';
import warehouseImg03 from '@/assets/images/feat_warehouse_03.jpg';
import warehouseImg04 from '@/assets/images/feat_warehouse_04.jpg';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="特徴 | 株式会社ミエフソー | 製材機械の再生品、中古品の販売"  description="製材機械の再生・販売（再生品・中古品）におけるミエフソーの強みをご紹介。多くの実績に基づく技術力、現場に合わせた提案力、豊富な在庫力で安定稼働を支えます。">
  <PageHeader
    title="特&nbsp;徴"
    subtitle="Key Features"
    bgImage="/assets/images/header_features.jpg"
  />

  <p class="text-center-self">
    長年にわたり製材現場と向き合い、製材一次加工機械の販売・再生を通じて安定稼働を支えてきました。その歩みの中で磨いてきたのが、確かな技術力、柔軟な提案力、そして迅速に応える在庫力の三つの強みです。
  </p>

  <ul id="topNav" class="p-feat-head-link">
    <li><a href="#technical">多くの実績に基づいた<br>技術力</a></li>
    <li><a href="#proposal">様々なニーズへの<br>提案力</a></li>
    <li><a href="#stock">自社倉庫保有の<br>在庫力</a></li>
  </ul>

  <!-- 技術力 -->
  <section id="technical" class="p-feat-technical">
    <h2 class="bund-title">多くの実績に基づいた技術力</h2>
    <p class="text-center-self">
      多くの導入実績の中で培ってきた技術をもとに、製品は完全分解から再組立まで一貫して対応しています。<br>
      <br>
      洗浄を行い、分解後は部品一つひとつを・研磨し、摩耗や劣化の状態を確認。補修・交換を経て再塗装を施し、精度を確認しながら組み上げています。表面だけではない、本質的な再生を行っています。
    </p>
    <ul class="tile-imgaes container">
      <li>
        <Image src={technicalImg01} alt="磨き・塗装"/>
        <span>1. 磨き・塗装</span>
      </li>
      <li>
        <Image src={technicalImg02} alt="ベアリング、スプロケット等の交換"/>
        <span>2. ベアリング、スプロケット等の交換</span>
      </li>
      <li>
        <Image src={technicalImg03} alt="組立"/>
        <span>3. 組立</span>
      </li>
      <li>
        <Image src={technicalImg04} alt="調整・仕上げ"/>
        <span>4. 調整・仕上げ</span>
      </li>
    </ul>
    <p class="text-center-self">
      こうした工程を徹底することで、導入後も安定した稼働と長期使用を実現し、現場の生産性と品質を支えています。弊社にて再生整備を行いました事例は<a href={`${base}/projects`}>導入実績</a>ページをご参照ください。
    </p>
  </section>

  <!-- 提案力 -->
  <section id="proposal" class="p-feat-proposal">
    <h2 class="bund-title">様々なニーズへの提案力</h2>
    <div class="single-imgae container">
        <Image src={proposalImg} alt="様々なニーズへ対応できるようご提案をさせて頂きます"/>
        <p>
          豊富な知識と経験をもとに、設置スペースや既存ライン構成、生産目標など現場ごとの条件を丁寧に把握し、課題を整理します。さらに、仕様変更や改造にも柔軟に対応し、導入後の運用やメンテナンスまで見据えた最適なご提案を行っています。
        </p>
    </div>
    <div class="text-center-self">
      <h3>他社メーカーの送材車を石田の送材車に入れ替える場合</h3>
      <p>
        弊社ご提案内容の一例として、送材車を入れ替え対応を挙げさせて頂きます。<br>
        <br>
        通常、メーカーの異なる送材車を入れ替える場合は、レール基礎の解体、新設基礎の施工、レールの入替、場合によっては本体の位置調整も必要になることがございます。そういった場合、入れ替えの為に、対象の製材機械を 40 日ほど稼働を止めて頂く必要がございます。<br>
        <br>
        弊社にて、他社メーカーの送材車を石田の送材車に入れ替える場合は、既存のレールをそのまま利用できるよう弊社にて送材車の改造を施し、約 3 日で据付、試運転を実施することが可能です。
      </p>
    </div>
    <ul class="tile-imgaes container">
      <li class="p-feat-technical__image">
        <Image src={pickupImg01} alt="他社メーカーの送材車を石田の送材車に入れ替える場合のポイント"/>
      </li>
      <li class="p-feat-technical__image">
        <Image src={pickupImg02} alt="他社メーカーの送材車に合わせて改造・整備を行なった送材車"/>
      </li>
    </ul>
  </section>

  <!-- 在庫力 -->
  <section id="stock" class="p-feat-stock">
    <h2 class="bund-title">自社倉庫保有の在庫力</h2>
    <p class="text-center-self">
      約6,000㎡（1800坪）の敷地に3棟の倉庫を構え、豊富な在庫を保有することで、ご要望への素早い対応を可能にしています。修理やメンテナンス時の部品調達にも柔軟に対応し、導入後も安心してお使いいただける体制を整えています。
    </p>
    <ul class="tile-imgaes container">
      <li>
        <Image src={warehouseImg01} alt="ミエフソー倉庫外観"/>
      </li>
      <li>
        <Image src={warehouseImg02} alt="ミエフソー倉庫内1"/>
      </li>
      <li>
        <Image src={warehouseImg03} alt="ミエフソー倉庫内2"/>
      </li>
      <li>
        <Image src={warehouseImg04} alt="ミエフソー倉庫内3"/>
      </li>
    </ul>
  </section>

  <section id="stockList" class="p-purchase-info">
    <h3>弊社在庫品</h3>
    <ol>
      <li>IAT-1100 エアーテンション帯鋸盤 (石田)</li>
      <li>IAT-1200 エアーテンション帯鋸盤 (石田)</li>
      <li>IAH-1100 エアーテンション横型バンドソー (石田)</li>
      <li>ISD-900 全自動送材車 ヘッドブロック 3〜4本立 (石田)</li>
      <li>ISD-N900 全自動送材車 ヘッドブロック 3〜4本立 (石田)</li>
      <li>INC-900 センタードック 全自動送材車 ヘッドブロック4本立 (石田)</li>
      <li>INC-900 センタードック 本自動送材車 ヘッドブロック4本立 (石田)</li>
      <li>PNC45 チッパー機 ロータリースクリーン (富士)</li>
      <li>PNC40 チッパー機 (富士)</li>
      <li>PNC32 チッパー機 (富士)</li>
      <li>プレナーギャング PG-45C (菊川)</li>
      <li>プレナーギャング C80-F (太平)</li>
      <li>トリプルリッププレナー (横山)</li>
      <li>2面プレナー＆バリアブルギャングリッパー PMRG-6S (横山)</li>
      <li>ツインリッパー SW-50-2S (横山)</li>
      <li>RF55 ノーマンリングバーカー (エノ)</li>
      <li>IBD-500N型 ノーマンリングバーカー 4本アーム (石田)</li>
      <li>IBD-650N型 ノーマンリングバーカー 4本アーム (石田)</li>
      <li>IAT-1100 ワンマンツインバンドソー (石田)</li>
      <li>HM4-E型 全自動耳摺機械 2M・3M・4M (橋本)</li>
      <li>HM4-D型 全自動耳摺機械 U-I型 電気歩出機 (橋本)</li>
      <li>660型 チャージャー付 スケアリングソー (富士)</li>
      <li>キングチッパー 600W (富士)</li>
      <li>大型チッパー 550 (CKSチューキ)</li>
      <li>モルダー プロフィーマット23E 5軸 (ヴァイニッヒ)</li>
      <li>プロフィーマット45 (ヴァイニッヒ)</li>
      <li>モルダー 5軸 (ギリエ)</li>
      <li>バーク粉砕機 モーター55kw</li>
      <li>全自動結束機 (杉本)</li>
      <li>全自動エジャー (石田)</li>
      <li>テーブルリフター 2t 数台</li>
    </ol>
    <span id="updateDate" class="update-date">2026/9 更新</span>
    <p>
      上記記載にはない機械もございます。<br>お求めの機械がございましたら<a href={`${base}/contact`}>お問い合わせページ</a>に記載の連絡先よりお気軽にお問い合わせください。
    </p>
  </section>

  <TopBtn href="#topNav" />

</BaseLayout>
