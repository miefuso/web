---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/common/PageHeader.astro";
import TopBtn from "@/components/common/TopBtn.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="在庫一覧 | 株式会社ミエフソー | 製材機械の再生品、中古品の販売" description="ミエフソーの在庫機械の一覧です。製材一次加工機械の再生品・中古品を、自社倉庫に豊富に取り揃えています。お求めの機械がございましたらお気軽にお問い合わせください。">
  <PageHeader
    title="在庫一覧"
    subtitle="Stock"
    bgImage="/assets/images/header_stock.jpg"
  />

  <section class="p-purchase-info p-purchase-info--stock">
    <ol>
      <li>IAT-1100 エアーテンション帯鋸盤 (石田)</li>
      <li>IAT-1200 エアーテンション帯鋸盤 (石田)</li>
      <li>IAH-1100 エアーテンション横型バンドソー (石田)</li>
      <li>ISD-900 全自動送材車 ヘッドブロック 3〜4本立 (石田)</li>
      <li>ISD-N900 全自動送材車 ヘッドブロック 3〜4本立 (石田)</li>
      <li>
        INC-900 センタードック 全自動送材車<br>
        ヘッドブロック4本立 (石田)
      </li>
      <li>
        INC-900 センタードック 本自動送材車<br>
        ヘッドブロック4本立 (石田)
      </li>
      <li>PNC45 チッパー機 ロータリースクリーン (富士)</li>
      <li>PNC40 チッパー機 (富士)</li>
      <li>PNC32 チッパー機 (富士)</li>
      <li>プレナーギャング PG-45C (菊川)</li>
      <li>プレナーギャング PG-45A（菊川）</li>
      <li>プレナーギャング C80-F (太平)</li>
      <li>
        A43-H ギャングソー（太平）<br>
        モーター 30kw キャタピラ巾 350W
      </li>
      <li>RS-400 リップソー（平安）モーター 15kw</li>
      <li>BC-400 バークチッパー（富士）モーター 30kw</li>
      <li>YV-2型 ツーマンオートテーブル（横山）</li>
      <li>トリプルリッププレナー (横山)</li>
      <li>2面プレナー＆バリアブルギャングリッパー PMRG-6S (横山)</li>
      <li>ツインリッパー SW-50-2S (横山)</li>
      <li>RF55 ノーマンリングバーカー (エノ)</li>
      <li>IBD-500N型 ノーマンリングバーカー 4本アーム (石田)</li>
      <li>IBD-650N型 ノーマンリングバーカー 4本アーム (石田)</li>
      <li>IAT-1100 ワンマンツインバンドソー (石田)</li>
      <li>HM4-E型 全自動耳摺機械 2M・3M・4M (橋本)</li>
      <li>HM4-D型 自動耳摺機械 U-I型 電気歩出機 (橋本)</li>
      <li>660型 チャージャー付 スケアリングソー (富士)</li>
      <li>キングチッパー 600W (富士)</li>
      <li>大型チッパー 550 (CKSチューキ)</li>
      <li>モルダー プロフィーマット23E 5軸 (ヴァイニッヒ)</li>
      <li>プロフィーマット45 (ヴァイニッヒ)</li>
      <li>モルダー 5軸 (ギリエ)</li>
      <li>バーク粉砕機 モーター55kw</li>
      <li>全自動結束機 (杉本)</li>
      <li>全自動エジャー (石田)</li>
      <li>テーブルリフター 2t 数台</li>
      <li>結束機 ストラパック アーチ型</li>
      <li>
        圧力式エアーコンプレッサー（日立・整備済）<br>
        2.2kw 数台　3.7kw 数台　11kw
      </li>
      <li>プレートファン各種</li>
      <li>高圧送風機 マサル号 No.7、No.8、No.10</li>
      <li>モーター 0.75kw〜55kw 各種色々</li>
      <li>ギアーモーター 0.4kw〜3.7kw 各種色々</li>
